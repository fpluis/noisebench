# Generated by scripts/analyze.ts, committed so the site opens with no database.
# Prettier fills long number arrays differently from JSON.stringify, so without
# this `npm run format` and `npm run analyze` would each undo the other and every
# re-analysis would arrive buried in whitespace.
site/data/

# Fixture data, kept byte-for-byte as it was fetched.
datasets/

# Prose on these pages is written one paragraph per line, so a sentence edited
# later shows up as one changed line rather than as a reflowed block. Prettier
# fills text to the print width and would undo that on every run.
site/*.html

# Downloaded provider plugins. Prettier tries to read the binaries and dies on
# their length.
terraform/.terraform/
