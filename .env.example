# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Connection string used by every script. The `db:up` docker-compose service
# below exposes postgres on localhost:5433 with these credentials.
DATABASE_URL=postgres://noisebench:noisebench@localhost:5433/noisebench

# ---------------------------------------------------------------------------
# Inference (OpenRouter)
# ---------------------------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional attribution headers OpenRouter surfaces on your dashboard.
OPENROUTER_REFERER=https://github.com/your-org/noisebench
OPENROUTER_TITLE=noisebench

# ---------------------------------------------------------------------------
# On-chain ForecastRegistry
# ---------------------------------------------------------------------------
# Target chain. Defaults to Base mainnet (8453) when unset.
#   8453   Base mainnet  — requires ALLOW_MAINNET=true (see below)
#   84532  Base Sepolia  — the testnet rehearsal target
#   31337  local hardhat/anvil node
CHAIN_ID=84532

# Writing to mainnet is irreversible and costs real money, so it must be asked
# for twice: CHAIN_ID=8453 AND this flag. Any other chain ignores it.
ALLOW_MAINNET=false

# Address of the deployed ForecastRegistry contract (see ../forecast-registry).
# This is chain-specific — a Sepolia deployment has a different address than the
# mainnet one, so it must be changed alongside CHAIN_ID.
FORECAST_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Comma-separated RPC endpoints. The submitter rotates through this list when a
# provider fails, appending only the public fallbacks that serve CHAIN_ID —
# endpoints for other chains are never mixed in. Unset falls back to the known
# public endpoints for the chain, if any.
RPC_URLS=https://sepolia.base.org

# Batching configuration for on-chain forecast submissions.
FORECAST_BATCH_SIZE=50
FORECAST_BATCH_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Wallet management
# ---------------------------------------------------------------------------
# Each forecaster (LLM model) gets its own wallet, derived from the master
# mnemonic in `.master` (run `npm run generate-master-mnemonic` to create it).
# The funder key in `.funder.txt` holds the ETH used to top up those wallets.
FORECAST_FUNDING_PKEY_PATH=.funder.txt

# Minimum wallet balance (in ETH). Below this, a forecaster wallet is topped up
# to THRESHOLD_BALANCE from the funder wallet before the benchmark runs.
#
# Funding happens ONLY at startup. A wallet that runs dry mid-run has its
# batches rejected as insufficient-funds, which is non-retryable and silently
# discards them, so this must cover every batch the forecaster will submit
# (forecasts / FORECAST_BATCH_SIZE, plus one attribute transaction). Measure the
# real per-batch gas with a Base Sepolia rehearsal before setting it.
THRESHOLD_BALANCE=0.001

# The research model recorded on-chain as an attribute of each forecaster. The
# forecasting model attribute is set per forecaster to its OpenRouter slug.
RESEARCH_MODEL=local-research-v1

# When true, the benchmark writes forecasts to the DB but does NOT submit them
# on-chain (useful for local dry-runs without a funded wallet). Default false.
SKIP_ONCHAIN=false

# ---------------------------------------------------------------------------
# Testing / rehearsal knobs
# ---------------------------------------------------------------------------
# Replace OpenRouter with a deterministic offline stand-in (src/llm-fake.ts), so
# the full pipeline can be rehearsed at production volume for $0. Forecasts
# produced this way are SYNTHETIC — never publish such a run. Default false.
NOISEBENCH_FAKE_INFERENCE=false

# Simulated per-call latency for the fake, in milliseconds. Raise it to make
# concurrency and batch-timer behaviour resemble a real run.
NOISEBENCH_FAKE_LATENCY_MS=5

# Max Postgres connections. A run drives `models × concurrency` tasks in
# parallel (20 × 6 = 120), so the pg default of 10 serialises the write path.
PG_POOL_MAX=20
