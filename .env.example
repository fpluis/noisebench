# Copy this file to `.env` and fill in the values. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Connection string used by every script. The `db:up` docker-compose service
# below exposes postgres on localhost:5433 with these credentials.
DATABASE_URL=postgres://noisebench:noisebench@localhost:5433/noisebench

# ---------------------------------------------------------------------------
# Inference (OpenRouter)
# ---------------------------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional attribution headers OpenRouter surfaces on your dashboard.
OPENROUTER_REFERER=https://github.com/your-org/noisebench
OPENROUTER_TITLE=noisebench

# ---------------------------------------------------------------------------
# On-chain ForecastRegistry (Base mainnet, chainId 8453)
# ---------------------------------------------------------------------------
# Address of the deployed ForecastRegistry contract (see ../forecast-registry).
FORECAST_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Comma-separated list of Base RPC endpoints. The submitter rotates through this
# list (plus a set of public fallbacks) when a provider fails. Leaving this
# unset falls back to the public endpoints only.
BASE_RPC_URLS=https://mainnet.base.org

# Batching configuration for on-chain forecast submissions.
FORECAST_BATCH_SIZE=50
FORECAST_BATCH_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Wallet management
# ---------------------------------------------------------------------------
# Each forecaster (LLM model) gets its own wallet, derived from the master
# mnemonic in `.master` (run `npm run generate-master-mnemonic` to create it).
# The funder key in `.funder.txt` holds the ETH used to top up those wallets.
FORECAST_FUNDING_PKEY_PATH=.funder.txt

# Minimum wallet balance (in ETH). Below this, a forecaster wallet is topped up
# to THRESHOLD_BALANCE from the funder wallet before the benchmark runs.
THRESHOLD_BALANCE=0.001

# The research model recorded on-chain as an attribute of each forecaster. The
# forecasting model attribute is set per forecaster to its OpenRouter slug.
RESEARCH_MODEL=local-research-v1

# When true, the benchmark writes forecasts to the DB but does NOT submit them
# on-chain (useful for local dry-runs without a funded wallet). Default false.
SKIP_ONCHAIN=false
